{
  "info": {
    "_postman_id": "hrms-api-fixed",
    "name": "HRMS Backend API - FIXED",
    "description": "Fixed HRMS API collection with proper French endpoint names and validated payloads",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. EMPLOYEES CRUD",
      "item": [
        {
          "name": "1.1 POST Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
                  "});",
                  "pm.test(\"Response has ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.idEmploye).to.exist;",
                  "    pm.collectionVariables.set('employeeId', jsonData.idEmploye);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Martin\",\n  \"prenom\": \"Pierre\",\n  \"poste\": \"Développeur\",\n  \"email\": \"pierre.martin@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employes"]
            }
          }
        },
        {
          "name": "1.2 GET All Employees",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employes"]
            }
          }
        },
        {
          "name": "1.3 GET Employee by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Response has required fields\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.idEmploye).to.exist;",
                  "        pm.expect(jsonData.nom).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employes/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employes", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "1.4 PUT Update Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Martin\",\n  \"prenom\": \"Pierre\",\n  \"poste\": \"Senior Developer\",\n  \"email\": \"pierre.martin.updated@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employes/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employes", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "1.5 DELETE Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204 or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([204, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employes/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employes", "{{employeeId}}"]
            }
          }
        }
      ]
    },
